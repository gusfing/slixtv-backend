<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Security: Block direct access to data folder, json database, and environment files
  RewriteRule ^data(/.*)?$ - [F,L]
  RewriteRule \.env$ - [F,L]

  # 1. Stalker Reverse Proxy routes (APIs, Portals, Channel Logos, and Posters)
  RewriteRule ^portal/(.*)$ proxy.php [QSA,L]
  RewriteRule ^stalker_portal/(.*)$ proxy.php [QSA,L]
  RewriteRule ^misc/(.*)$ proxy.php [QSA,L]
  RewriteRule ^picon/(.*)$ proxy.php [QSA,L]
  RewriteRule ^screenshots/(.*)$ proxy.php [QSA,L]
  RewriteRule ^posters/(.*)$ proxy.php [QSA,L]
  RewriteRule ^covers/(.*)$ proxy.php [QSA,L]
  RewriteRule (.*)load\.php$ proxy.php [QSA,L]

  # 2. SlixTV App Endpoints
  RewriteRule ^api\.php$ api.php [QSA,L]
  RewriteRule ^check-device\.php$ check-device.php [QSA,L]

  # 3. Dashboard REST API
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]

  # 4. Serve existing static files directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. SPA Frontend Fallback
  RewriteRule ^ index.html [L]
</IfModule>

# Block sensitive file downloads
<FilesMatch "^(db\.json|\.env|package\.json|server\.js)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH"
  Header set Access-Control-Allow-Headers "X-Requested-With, Content-Type, Authorization, X-Api-Key, Accept, Origin"
  Header set Access-Control-Allow-Credentials "true"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

Options -Indexes

{
  "version": 2,
  "rewrites": [
    {
      "source": "/portal/(.*)",
      "destination": "/api/portal/$1"
    },
    {
      "source": "/stalker_portal/(.*)",
      "destination": "/api/stalker_portal/$1"
    },
    {
      "source": "/misc/(.*)",
      "destination": "/api/misc/$1"
    },
    {
      "source": "/screenshots/(.*)",
      "destination": "/api/screenshots/$1"
    },
    {
      "source": "/posters/(.*)",
      "destination": "/api/posters/$1"
    },
    {
      "source": "/covers/(.*)",
      "destination": "/api/covers/$1"
    },
    {
      "source": "/picon/(.*)",
      "destination": "/api/picon/$1"
    },
    {
      "source": "/api.php",
      "destination": "/api/api.php"
    },
    {
      "source": "/check-device.php",
      "destination": "/api/check-device.php"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}

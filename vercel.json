{
  "version": 2,
  "name": "slixtv-dashboard",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/[...slug]"
    },
    {
      "source": "/((?!assets/|images/|assistant/|api/|favicon\\.png|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
